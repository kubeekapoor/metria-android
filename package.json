{
  "name": "metria-android",
  "productName": "Metría",
  "version": "1.2.0",
  "private": true,
  "description": "Metría para Android - Control de finanzas personales (flujo de caja)",
  "type": "module",
  "scripts": {
    "sync": "npm run build:web && cap sync android",
    "open:android": "cap open android",
    "build:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "build:apk": "npm run sync && cd android && ./gradlew assembleRelease",
    "test": "node --test tests/*.test.js",
    "sync:tokens": "node scripts/sync-design-tokens.mjs",
    "build:web": "npm run sync:tokens && esbuild src/core/boot.js --bundle --format=iife --target=es2022 --outfile=www/dist/boot.js",
    "test:ui": "node tests/ui-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "scrypt-js": "3.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1"
  },
  "license": "AGPL-3.0-only"
}
